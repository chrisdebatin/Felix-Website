# Öffentliche Adresse der Website (ohne Schrägstrich am Ende).
# Wird für Canonical-URLs, hreflang, Sitemap, Open-Graph-Bild und JSON-LD genutzt.
NEXT_PUBLIC_SITE_URL=https://www.felix-ruft-an.de

# Resend (https://resend.com) – API-Key mit "Sending access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Absender der E-Mails. Die Domain muss in Resend verifiziert sein.
RESEND_FROM_EMAIL="Felix <hallo@felix-ruft-an.de>"

# Optional: Empfänger für neue Buchungen (und Kontaktanfragen, falls CONTACT_NOTIFY_EMAIL fehlt).
# Ohne Angabe gehen alle Leads an info@felix-ruft-an.de (siehe lib/email/send.ts).
# BOOKING_NOTIFY_EMAIL=info@felix-ruft-an.de

# Optional: eigene Adresse für Kontaktanfragen.
# CONTACT_NOTIFY_EMAIL=kontakt@felix-ruft-an.de

# Vercel Web Analytics (cookielos). Erst auf "1" setzen, wenn Web Analytics im Vercel-Projekt aktiviert ist.
NEXT_PUBLIC_VERCEL_ANALYTICS=0
